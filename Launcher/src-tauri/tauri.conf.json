{
  "build": {
    "beforeDevCommand": "cls && yarn dev",
    "beforeBuildCommand": "cls && yarn build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Project Launcher",
    "version": "1.3.8"
  },
  "tauri": {
    "allowlist": {
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "http://127.0.0.1:3551/**",
          "http://localhost:5000/**"
        ]
      },
      "shell": {
        "all": true,
        "execute": true
      },
      "all": true,
      "protocol": {
        "all": true,
        "assetScope": [
          "*/**"
        ]
      },
      "fs": {
        "all": true,
        "scope": [
          "*/**"
        ]
      }
    },
    "windows": [
      {
        "fullscreen": false,
        "maximizable": true,
        "resizable": true,
        "title": "Project Launcher",
        "decorations": true,
        "center": true,
        "transparent": true,
        "minWidth": 880,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; img-src * data: blob:;"
    },
    "bundle": {
      "active": true,
      "targets": [
        "nsis",
        "updater"
      ],
      "identifier": "com.project.app",
      "icon": [
        "icons/icon.icns",
        "icons/logo.ico"
      ],
      "resources": [
        "resources/Project Reboot.dll",
        "resources/Cobalt.dll",
        "resources/node/*",
        "resources/nova-proxy/**/*",
        "resources/Backend-Coordinator/**/*"
      ]
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/JustAdev742/Project-Jovian/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5RkE1QjQwRUYxQThBMDYKUldRR2locnZRRnY2bVMydlpUc2Q0SG5TZE41ak83UVZYOTdhaGg4MW5UQXRUbFB5RkZ1aWw3cjcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
